  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f8a7f98bd29a49a4899344a92bb411e9, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::QuestDialogueNPC
  text: {fileID: 1015296734}
  dialogueBox: {fileID: 1031431018}
  dialogueCam: {fileID: 540006436}
  textSpeed: 0.05
  requiredItemID: CarKey
  hasAcceptedQuest: 0
  isQuestComplete: 0
  introductionLines:
  - 'Hello, Marsh.

    Seems you decided to sleep in.'
  - While you're up, could you go find my car key? It's around here somewhere.
  waitingLines:
  - Have you found my key yet?
  completionLines:
  - Thank you. Now, your Grandad's got work to do, so I can't drive you into town
    like you asked.
  - You'll have to walk.
  - Follow the path out front to town, it should get you there in no time.
  postQuestLines:
  - Alright, off with you! Don't want the shops to close before you get there, do
    you?
  npcName: guy
  questData: {fileID: 11400000, guid: f18cd664a761bf34e8d2cfd2cacc56af, type: 2}
