  requiredItemID: CarKey
  hasAcceptedQuest: 0
  isQuestComplete: 0
  introductionLines:
  - 'Hello, Marsh.

    Seems you decided to sleep in.'
  - While you're up, could you go find my car key? It's around here somewhere.
  waitingLines:
  - Have you found my key yet?
  completionLines:
  - Thanks for grabbing that for me. I've got  work to do, so I can't drive you into
    town like you asked.
  - You're gonna have to walk.
  postQuestLines:
  - If I need your help, ill lyk
  npcName: guy
