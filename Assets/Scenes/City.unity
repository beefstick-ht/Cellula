--- !u!114 &1699203183
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1699203182}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f8a7f98bd29a49a4899344a92bb411e9, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::QuestDialogueNPC
  text: {fileID: 1426676110}
  dialogueBox: {fileID: 791690838}
  dialogueCam: {fileID: 2313895}
  textSpeed: 0.05
  requiredItemID: Pear
  hasAcceptedQuest: 0
  isQuestComplete: 0
  introductionLines:
  - 'Hello !

    Aren''t you supposed to be helping for the party?'
  - This year Pops says I have a very special role.
  - Though, I can't remember where I am going or what I am doing.
  - Say, if you could please bring me some food perhaps I could remember where the
    party is?
  waitingLines:
  - Have you found anything?
  completionLines:
  - "Hey! Thanks! \n"
  - Now I can remember it all.
  - The party is up the path where the forest is. If you follow the road to my left
    and take a right, you can't miss the entrance.
  postQuestLines:
  - Thanks!
  npcName: Boy
  questData: {fileID: 11400000, guid: 8b567d06b94c8a5488d3140579bcf1b2, type: 2}
