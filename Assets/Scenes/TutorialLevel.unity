  dialogueCam: {fileID: 1020036497}
  textSpeed: 0.05
  interactionLines:
  - 'You go to open the fridge, but stop yourself. Somehow, you feel your Grandpa''s
    eyes drill into the back of your head. '
  - 'The whispers of a foul, rusty smell assault your nose just behind the door. '
  npcName: Fridge
